---
// SPDX-License-Identifier: MIT

import BaseLayout from "../layouts/BaseLayout.astro";
import type { Realm } from "../types";

let realms: Realm[] = [];
try {
  const realmsJson = await import("../data/realms.json");
  realms = realmsJson.default;
} catch {
  console.warn("Could not load realms.json");
}

let indexes: any = {};
try {
  indexes = await import("../data/indexes.json").then((m) => m.default);
} catch {
  console.warn("Could not load indexes.json");
}

let tracks: any[] = [];
try {
  tracks = await import("../data/tracks.json").then((m) => m.default);
} catch {
  console.warn("Could not load tracks.json");
}

const realmStats = realms.map(realm => {
  const realmTracks = tracks.filter(t => t.realm === realm.id);
  const artists = [...new Set(realmTracks.map(t => t.artist))];
  const years = [...new Set(realmTracks.map(t => t.year))].sort((a, b) => a - b);

  return {
    ...realm,
    trackCount: realmTracks.length,
    artistCount: artists.length,
    yearRange: years.length > 0 ? [years[0], years[years.length - 1]] : [0, 0]
  };
});
---

<BaseLayout>
  <div class="max-w-6xl mx-auto">
    <div class="mb-12">
      <h1 class="text-5xl font-bold text-white mb-4">The 7 Realms</h1>
      <p class="text-neutral-300 text-lg max-w-3xl">
        Music transcends genres. Discover {realms.length} thematic realms that bridge styles and emotions.
        Each realm represents a distinct sonic philosophy and emotional journey.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-7 gap-4 mb-12">
      {realmStats.map(realm => (
        <a
          href={`/realms/${realm.id}`}
          class="group relative overflow-hidden rounded-lg p-6 bg-gradient-to-br from-ink-800 to-ink-900 border border-accent-500 border-opacity-30 hover:border-opacity-100 transition-all hover:shadow-lg hover:shadow-accent-500/20 min-h-64 flex flex-col justify-between"
        >
          <div>
            <div class="text-5xl mb-3 group-hover:scale-110 transition-transform">{realm.iconEmoji}</div>
            <h2 class="text-2xl font-bold text-white group-hover:text-accent-400 mb-2">{realm.name}</h2>
            <p class="text-sm text-neutral-400 mb-4">{realm.description}</p>
          </div>

          <div class="space-y-2 text-xs">
            <div class="flex items-center gap-2">
              <span class="text-accent-400">♪</span>
              <span class="text-neutral-300">{realm.trackCount} tracks</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-accent-400">👥</span>
              <span class="text-neutral-300">{realm.artistCount} artists</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-accent-400">📅</span>
              <span class="text-neutral-300">{realm.yearRange[0]}-{realm.yearRange[1]}</span>
            </div>
            <div class="pt-2 border-t border-accent-500/20">
              <p class="text-accent-300 italic">{realm.mood}</p>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="bg-gradient-to-r from-accent-500/10 to-accent-500/5 border border-accent-500/20 rounded-lg p-8 mb-8">
      <h2 class="text-2xl font-bold text-white mb-4">Realm Characteristics</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {realmStats.map(realm => (
          <div class="space-y-2">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-2xl">{realm.iconEmoji}</span>
              <h3 class="text-lg font-bold text-accent-400">{realm.name}</h3>
            </div>
            <div class="space-y-1 text-sm text-neutral-300 pl-8">
              <div><strong>Genres:</strong> {realm.genres.join(", ")}</div>
              <div><strong>BPM Range:</strong> {realm.bpmRange.min}-{realm.bpmRange.max}</div>
              <div><strong>Mood:</strong> {realm.mood}</div>
              <div><strong>Tracks:</strong> {realm.trackCount} ({Math.round(realm.trackCount / realmStats.reduce((sum, r) => sum + r.trackCount, 0) * 100)}%)</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="text-center py-8">
      <p class="text-neutral-400">
        Explore each realm to discover tracks, artists, and sounds from across the genres.
      </p>
    </div>
  </div>
</BaseLayout>
