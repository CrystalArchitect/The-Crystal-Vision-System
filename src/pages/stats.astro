---
// SPDX-License-Identifier: MIT

import BaseLayout from '../layouts/BaseLayout.astro';
import type { Track } from "../types";

let tracks: Track[] = [];
try {
  tracks = await import("../data/tracks.json").then((m) => m.default);
} catch {
  console.warn("Could not load tracks.json - run \"npm run data\" first");
}

// Calculate statistics
const categories = new Map<string, number>();
const years = new Map<number, number>();
const artists = new Map<string, number>();
const genres = new Map<string, number>();
const realms = new Map<string, number>();

tracks.forEach(track => {
  categories.set(track.category, (categories.get(track.category) || 0) + 1);
  years.set(track.year, (years.get(track.year) || 0) + 1);
  artists.set(track.artist, (artists.get(track.artist) || 0) + 1);

  // Count genres (tracks can have multiple)
  track.genres.forEach(genre => {
    genres.set(genre, (genres.get(genre) || 0) + 1);
  });

  // Count realms
  if (track.realm) {
    realms.set(track.realm, (realms.get(track.realm) || 0) + 1);
  }
});

const topArtists = Array.from(artists.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);

const sortedGenres = Array.from(genres.entries())
  .sort((a, b) => b[1] - a[1]);

const sortedRealms = Array.from(realms.entries())
  .sort((a, b) => b[1] - a[1]);

const uniqueArtists = artists.size;
const yearSpan = Math.max(...Array.from(years.keys())) - Math.min(...Array.from(years.keys()));
const avgTracksPerArtist = (tracks.length / uniqueArtists).toFixed(1);
---

<BaseLayout title="Statistics">
  <div class="space-y-8">
    <div>
      <h1 class="text-4xl font-bold text-white mb-2">Library Analytics</h1>
      <p class="text-neutral-400">Global distribution analytics for The Crystal Vision System</p>
    </div>

    <!-- Global Statistics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-gradient-to-br from-accent-500/20 to-accent-500/5 border border-accent-500/30 rounded-lg p-6">
        <div class="text-sm text-neutral-400 mb-2">Total Tracks</div>
        <div class="text-3xl font-bold text-accent-400">{tracks.length.toLocaleString()}</div>
      </div>
      <div class="bg-gradient-to-br from-accent-500/20 to-accent-500/5 border border-accent-500/30 rounded-lg p-6">
        <div class="text-sm text-neutral-400 mb-2">Artists</div>
        <div class="text-3xl font-bold text-accent-400">{uniqueArtists}</div>
      </div>
      <div class="bg-gradient-to-br from-accent-500/20 to-accent-500/5 border border-accent-500/30 rounded-lg p-6">
        <div class="text-sm text-neutral-400 mb-2">Genres</div>
        <div class="text-3xl font-bold text-accent-400">{genres.size}</div>
      </div>
      <div class="bg-gradient-to-br from-accent-500/20 to-accent-500/5 border border-accent-500/30 rounded-lg p-6">
        <div class="text-sm text-neutral-400 mb-2">Realms</div>
        <div class="text-3xl font-bold text-accent-400">{realms.size}</div>
      </div>
    </div>

    <!-- Realm Distribution -->
    <div class="rounded-lg bg-ink-800 p-6 border border-accent-500/20">
      <h2 class="mb-4 text-2xl font-bold">Distribution by Realm</h2>
      <div class="space-y-3">
        {
          sortedRealms.map(([realm, count]) => (
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span class="text-neutral-300">{realm}</span>
                <span class="text-accent-400 font-bold">{count} ({((count / tracks.length) * 100).toFixed(1)}%)</span>
              </div>
              <div class="bg-ink-700 rounded h-2 overflow-hidden">
                <div
                  class="bg-gradient-to-r from-accent-500 to-accent-400 h-full"
                  style={{width: `${(count / Math.max(...sortedRealms.map(r => r[1]))) * 100}%`}}
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Genre Distribution -->
    <div class="rounded-lg bg-ink-800 p-6 border border-accent-500/20">
      <h2 class="mb-4 text-2xl font-bold">Top Genres</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        {
          sortedGenres.slice(0, 12).map(([genre, count]) => (
            <div class="bg-ink-700 rounded p-3">
              <div class="text-sm font-semibold text-white truncate">{genre}</div>
              <div class="text-xs text-neutral-400 mt-1">{count} tracks</div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Categories -->
    <div class="rounded-lg bg-ink-800 p-6 border border-accent-500/20">
      <h2 class="mb-4 text-2xl font-bold">Distribution by Category</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          Array.from(categories.entries())
            .sort((a, b) => b[1] - a[1])
            .map(([category, count]) => (
              <div class="rounded bg-ink-700 p-4 text-center border border-accent-500/10">
                <div class="text-accent-400 font-semibold">{category}</div>
                <div class="mt-2 text-2xl font-bold">{count}</div>
                <div class="text-xs text-neutral-400 mt-1">{((count / tracks.length) * 100).toFixed(1)}%</div>
              </div>
            ))
        }
      </div>
    </div>

    <!-- Top Artists -->
    <div class="rounded-lg bg-ink-800 p-6 border border-accent-500/20">
      <h2 class="mb-4 text-2xl font-bold">Top 10 Artists</h2>
      <div class="space-y-2">
        {
          topArtists.map(([artist, count], idx) => (
            <div class="flex items-center gap-3 rounded bg-ink-700 px-4 py-2">
              <div class="text-accent-400 font-bold w-6">{idx + 1}</div>
              <div class="flex-1">
                <span>{artist}</span>
              </div>
              <span class="text-accent-400">{count} tracks</span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Years Distribution -->
    <div class="rounded-lg bg-ink-800 p-6 border border-accent-500/20">
      <h2 class="mb-4 text-2xl font-bold">Tracks by Year</h2>
      <div class="text-sm text-neutral-400 mb-4">Year Range: {Math.min(...Array.from(years.keys()))} - {Math.max(...Array.from(years.keys()))} ({yearSpan} years)</div>
      <div class="space-y-2">
        {
          Array.from(years.entries())
            .sort((a, b) => b[0] - a[0])
            .slice(0, 15)
            .map(([year, count]) => (
              <div class="flex items-center justify-between rounded bg-ink-700 px-4 py-2">
                <span className="text-neutral-300 w-12">{year}</span>
                <div className="flex-1 mx-3">
                  <div className="h-2 rounded bg-ink-600 overflow-hidden">
                    <div
                      className="bg-gradient-to-r from-accent-500 to-accent-400 h-full"
                      style={{width: `${(count / Math.max(...Array.from(years.values()))) * 100}%`}}
                    />
                  </div>
                </div>
                <span className="text-accent-400 font-bold min-w-16 text-right">{count}</span>
              </div>
            ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
