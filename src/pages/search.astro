---
// SPDX-License-Identifier: MIT

import BaseLayout from '../layouts/BaseLayout.astro';
import AdvancedSearch from '../components/react/AdvancedSearch';
import MoodDiscovery from '../components/react/MoodDiscovery';
import type { Track, Realm } from "../types";

let tracks: Track[] = [];
let realms: Realm[] = [];

try {
  tracks = await import("../data/tracks.json").then((m) => m.default);
} catch {
  console.warn("Could not load tracks.json - run \"npm run data\" first");
}

try {
  realms = await import("../data/realms.json").then((m) => m.default);
} catch {
  console.warn("Could not load realms.json");
}
---

<BaseLayout title="Search & Discover">
  <div class="space-y-8">
    <div>
      <h1 class="text-4xl font-bold text-white mb-2">Search & Discover</h1>
      <p class="text-neutral-400">Explore {tracks.length} tracks with full-text search, BPM ranges, keys, genres, and mood-based discovery</p>
    </div>

    <!-- Tabs for Advanced Search and Mood Discovery -->
    <div class="rounded-lg bg-ink-800 p-6 border border-accent-500/20">
      <div class="flex gap-4 mb-6 border-b border-accent-500/20 pb-4">
        <a href="#advanced-search" class="text-white font-semibold hover:text-accent-400 transition">🔍 Advanced Search</a>
        <a href="#mood-discovery" class="text-neutral-400 font-semibold hover:text-accent-400 transition">🎵 Mood Discovery</a>
      </div>
    </div>

    <!-- Advanced Search Component -->
    <div id="advanced-search">
      <AdvancedSearch client:load {tracks} {realms} />
    </div>

    <!-- Mood Discovery Component -->
    <div id="mood-discovery" class="mt-12 scroll-mt-20">
      <MoodDiscovery client:load {tracks} {realms} />
    </div>
  </div>
</BaseLayout>
