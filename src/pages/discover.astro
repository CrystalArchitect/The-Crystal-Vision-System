---
// SPDX-License-Identifier: MIT

import BaseLayout from '../layouts/BaseLayout.astro';
import RealmMap from '../components/react/RealmMap';
import PlaylistGenerator from '../components/react/PlaylistGenerator';
import ArtistDiscovery from '../components/react/ArtistDiscovery';
import type { Track, Realm } from "../types";

let tracks: Track[] = [];
let realms: Realm[] = [];

try {
  tracks = await import("../data/tracks.json").then((m) => m.default);
} catch {
  console.warn("Could not load tracks.json - run \"npm run data\" first");
}

try {
  realms = await import("../data/realms.json").then((m) => m.default);
} catch {
  console.warn("Could not load realms.json");
}
---

<BaseLayout title="Discover">
  <div class="space-y-8">
    <div>
      <h1 class="text-4xl font-bold text-white mb-2">Discover</h1>
      <p class="text-neutral-400">Explore realms, find new music, and create perfect playlists</p>
    </div>

    <!-- Realm Map -->
    <RealmMap client:load {realms} {tracks} />

    <!-- Playlist Generator -->
    <PlaylistGenerator client:load {tracks} {realms} />

    <!-- Artist Discovery -->
    <ArtistDiscovery client:load {tracks} />
  </div>
</BaseLayout>
