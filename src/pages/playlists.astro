import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Playlists">
  <div class="space-y-8">
    <h1 class="text-4xl font-bold">Your Playlists</h1>

    <div class="rounded-lg bg-ink-800 p-8 text-center">
      <p class="text-ink-400">Playlists will be managed from the browser with localStorage</p>
      <p class="mt-2 text-sm text-ink-500">Add tracks to playlists from the search interface</p>
    </div>
  </div>
</BaseLayout>
