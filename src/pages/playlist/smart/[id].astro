---
// SPDX-License-Identifier: MIT

import BaseLayout from "../../../layouts/BaseLayout.astro";
import SmartPlaylistView from "../../../components/react/SmartPlaylistView";
import type { Track } from "../../../types";

// Smart playlists are user-created at runtime and fetched client-side, so there
// are no instances to prerender in a static build. Returning an empty list keeps
// the static build valid; the route is still rendered on demand by `astro dev`.
// Production static hosting of deep links would require an SSR adapter.
export function getStaticPaths() {
  return [];
}

const { id } = Astro.params;

let tracks: Track[] = [];
try {
  tracks = await import("../../../data/tracks.json").then((m) => m.default);
} catch {
  console.warn("Could not load tracks.json");
}
---

<BaseLayout>
  <div class="max-w-4xl mx-auto">
    <SmartPlaylistView client:load smartPlaylistId={id || ""} allTracks={tracks} />
  </div>
</BaseLayout>
