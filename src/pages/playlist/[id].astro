---
// SPDX-License-Identifier: MIT

import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaylistView from "../../components/react/PlaylistView";
import type { Track } from "../../types";

// Playlists are user-created at runtime and fetched client-side, so there are
// no instances to prerender in a static build. Returning an empty list keeps
// the static build valid; the route is still rendered on demand by `astro dev`.
// Production static hosting of deep links would require an SSR adapter.
export function getStaticPaths() {
  return [];
}

const { id } = Astro.params;

let tracks: Track[] = [];
try {
  tracks = await import("../../data/tracks.json").then((m) => m.default);
} catch {
  console.warn("Could not load tracks.json");
}
---

<BaseLayout>
  <div class="max-w-4xl mx-auto">
    <PlaylistView client:load playlistId={id || ""} allTracks={tracks} onMetaChange={() => window.location.reload()} />
  </div>
</BaseLayout>
