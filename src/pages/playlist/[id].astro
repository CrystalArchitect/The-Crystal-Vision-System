---
// SPDX-License-Identifier: MIT

import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaylistView from "../../components/react/PlaylistView";
import type { Track } from "../../types";

const { id } = Astro.params;

let tracks: Track[] = [];
try {
  tracks = await import("../../data/tracks.json").then((m) => m.default);
} catch {
  console.warn("Could not load tracks.json");
}
---

<BaseLayout>
  <div class="max-w-4xl mx-auto">
    <PlaylistView client:load playlistId={id || ""} allTracks={tracks} onMetaChange={() => window.location.reload()} />
  </div>
</BaseLayout>
