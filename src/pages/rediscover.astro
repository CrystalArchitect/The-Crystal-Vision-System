import BaseLayout from "../layouts/BaseLayout.astro";
import type { Track } from "../types";
import { findSimilar } from "../lib/similar";

let tracks: Track[] = [];

try {
  tracks = await import("../data/tracks.json").then((m) => m.default);
} catch {
  console.warn("Could not load tracks.json");
}

const ratedTracks = tracks.filter((t) => Math.random() < 0.1).slice(0, 5);
const recommendations = ratedTracks.length > 0
  ? Array.from(
      new Set(
        ratedTracks.flatMap((t) =>
          findSimilar(t, tracks, () => []).map((r) => r.track.id)
        )
      )
    )
      .map((id) => tracks.find((t) => t.id === id))
      .filter((t): t is Track => !!t)
      .slice(0, 20)
  : [];
---

<BaseLayout>
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold text-white mb-8">Rediscover</h1>

    {
      recommendations.length === 0 ? (
        <div class="text-center py-12 text-neutral-500">
          <p>Rate some tracks in the library to get personalized recommendations</p>
        </div>
      ) : (
        <div class="space-y-2">
          {recommendations.map((track) => (
            <a
              href={track.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="p-4 rounded-lg bg-ink-900 border border-ink-800 hover:border-accent hover:bg-ink-800 transition-colors group block"
            >
              <div class="font-semibold text-white group-hover:text-accent">{track.title}</div>
              <div class="text-xs text-neutral-500 mt-1">
                {track.artist} • {track.year} • {track.bpm} BPM
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
