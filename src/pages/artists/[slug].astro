---
// SPDX-License-Identifier: MIT

import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Track } from "../../types";

let tracks: Track[] = [];
let allArtists: string[] = [];

try {
  tracks = await import("../../data/tracks.json").then((m) => m.default);
  const artistSet = new Set(tracks.map((t) => t.artist));
  allArtists = Array.from(artistSet);
} catch {
  console.warn("Could not load tracks.json");
}

export function getStaticPaths() {
  return allArtists.map((artist) => ({
    params: { slug: artist.toLowerCase().replace(/\s+/g, "-").replace(/[^\w-]/g, "") },
    props: { artist },
  }));
}

const { artist } = Astro.props;
const artistTracks = tracks.filter((t) => t.artist === artist);
---

<BaseLayout>
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold text-white mb-2">{artist}</h1>
    <p class="text-neutral-400 mb-8">{artistTracks.length} tracks</p>

    {
      artistTracks.length === 0 ? (
        <div class="text-center py-12 text-neutral-500">
          <p>No tracks found for this artist</p>
        </div>
      ) : (
        <div class="space-y-2">
          {artistTracks.map((track) => (
            <a
              href={track.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="p-4 rounded-lg bg-ink-900 border border-ink-800 hover:border-accent hover:bg-ink-800 transition-colors group block"
            >
              <div class="font-semibold text-white group-hover:text-accent">{track.title}</div>
              <div class="text-xs text-neutral-500 mt-1">
                {track.year} • {track.bpm} BPM
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
