---
// SPDX-License-Identifier: MIT

import BaseLayout from "../layouts/BaseLayout.astro";
import TrackExplorer from "../components/react/TrackExplorer";
import type { Track } from "../types";

let tracks: Track[] = [];
let yearOptions: number[] = [];

try {
  tracks = await import("../data/tracks.json").then((m) => m.default);
  const years = [...new Set(tracks.map((t) => t.year))].sort((a, b) => b - a);
  yearOptions = years;
} catch {
  console.warn("Could not load tracks.json - run \"npm run data\" first");
}

const query = Astro.url.search;
---

<BaseLayout>
  <div class="max-w-7xl mx-auto">
    <h1 class="text-4xl font-bold text-white mb-8">Browse Tracks</h1>
    <TrackExplorer client:load {tracks} {yearOptions} initialQuery={query} />
  </div>
</BaseLayout>
