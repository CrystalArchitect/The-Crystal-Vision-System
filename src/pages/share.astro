---
// SPDX-License-Identifier: MIT

import BaseLayout from '../layouts/BaseLayout.astro';
import PlaylistSharer from '../components/react/PlaylistSharer';
import CommunityRatings from '../components/react/CommunityRatings';
import ComparisonSharer from '../components/react/ComparisonSharer';
import type { Track, Realm } from "../types";

let tracks: Track[] = [];
let realms: Realm[] = [];

try {
  tracks = await import("../data/tracks.json").then((m) => m.default);
} catch {
  console.warn("Could not load tracks.json - run \"npm run data\" first");
}

try {
  realms = await import("../data/realms.json").then((m) => m.default);
} catch {
  console.warn("Could not load realms.json");
}
---

<BaseLayout title="Share">
  <div class="space-y-8">
    <div>
      <h1 class="text-4xl font-bold text-white mb-2">Share & Collaborate</h1>
      <p class="text-neutral-400">Create shareable playlists, rate tracks, and compare realms with the community</p>
    </div>

    <!-- Playlist Sharer -->
    <PlaylistSharer client:load {tracks} {realms} />

    <!-- Community Ratings -->
    <CommunityRatings client:load {tracks} />

    <!-- Realm Comparison Sharer -->
    <ComparisonSharer client:load {realms} {tracks} />
  </div>
</BaseLayout>
