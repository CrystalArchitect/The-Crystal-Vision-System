---
// SPDX-License-Identifier: MIT

import BaseLayout from "../layouts/BaseLayout.astro";
import type { Track } from "../types";

let tracks: Track[] = [];
let artists: string[] = [];

try {
  tracks = await import("../data/tracks.json").then((m) => m.default);
  const artistCounts = new Map<string, number>();
  tracks.forEach((t) => {
    artistCounts.set(t.artist, (artistCounts.get(t.artist) || 0) + 1);
  });
  artists = Array.from(artistCounts.entries())
    .sort((a, b) => b[1] - a[1])
    .map(([artist]) => artist);
} catch {
  console.warn("Could not load tracks.json");
}
---

<BaseLayout>
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold text-white mb-8">Artists</h1>

    {
      artists.length === 0 ? (
        <div class="text-center py-12 text-neutral-500">
          <p>No artists found. Run "npm run data" to generate tracks.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {artists.map((artist) => {
            const count = tracks.filter((t) => t.artist === artist).length;
            return (
              <a
                href={`/artists/${artist.toLowerCase().replace(/\s+/g, "-").replace(/[^\w-]/g, "")}`}
                class="p-4 rounded-lg bg-ink-900 border border-ink-800 hover:border-accent hover:bg-ink-800 transition-colors group"
              >
                <div class="font-semibold text-white group-hover:text-accent">{artist}</div>
                <div class="text-xs text-neutral-500 mt-1">{count} tracks</div>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</BaseLayout>
