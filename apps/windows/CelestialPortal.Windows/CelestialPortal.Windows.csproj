<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformVersion>10.0.22621.0</TargetPlatformVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <AssemblyName>CelestialPortal</AssemblyName>
    <RootNamespace>CelestialPortal</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Celestial Portal Team</Authors>
    <Description>Voice-first governance system with immutable audit trails</Description>

    <UseWinUI>true</UseWinUI>
    <UseWindowsDesktopFeatures>true</UseWindowsDesktopFeatures>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241105001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="HttpClientFactory.Resilience" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\infrastructure\mcp\CrystalBus.MCP.csproj" Condition="Exists('..\..\..\infrastructure\mcp\CrystalBus.MCP.csproj')" />
  </ItemGroup>

</Project>
