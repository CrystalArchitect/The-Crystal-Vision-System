<?xml version="1.0" encoding="utf-8"?>
<Application
  x:Class="CelestialPortal.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:CelestialPortal">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="PrimaryColor">#2563eb</Color>
            <Color x:Key="SecondaryColor">#1e40af</Color>
            <Color x:Key="SuccessColor">#10b981</Color>
            <Color x:Key="WarningColor">#f59e0b</Color>
            <Color x:Key="ErrorColor">#ef4444</Color>
            <Color x:Key="BackgroundColor">#f9fafb</Color>

            <SolidColorBrush x:Key="PrimaryBrush" Color="{ThemeResource PrimaryColor}"/>
            <SolidColorBrush x:Key="SecondaryBrush" Color="{ThemeResource SecondaryColor}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
