# Copy to .env and fill in real values. Never commit .env.

# JWT signing secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin login. Generate ADMIN_PASSWORD_HASH with:
#   python backend/scripts/hash_password.py "your-password-here"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Defaults to a local SQLite file. Point this at a real Postgres/MySQL
# URL later (e.g. postgresql+psycopg2://user:pass@host/db) -- no route
# or model code needs to change, only this value and the driver package.
DATABASE_URL=sqlite:///./cc_admin.db

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Local LLM (llama.cpp) behind POST /api/v1/admin/generate.
# Run `python download_model.py` first to fetch the weights -- LLM_MODEL_PATH
# here must match MODEL_DIR/MODEL_FILENAME used by that script.
LLM_MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf
LLM_N_CTX=4096
LLM_N_THREADS=4

# download_model.py reads these directly (not via pydantic-settings).
# MODEL_REPO_ID=Qwen/Qwen2.5-3B-Instruct-GGUF
# MODEL_FILENAME=qwen2.5-3b-instruct-q4_k_m.gguf
# MODEL_DIR=models

# Cloud tier (tier 3) for POST /api/v1/admin/generate. Only used as a
# fallback when the local model isn't available, or when a request pins
# tier="cloud". Leave ANTHROPIC_API_KEY blank to disable this tier entirely
# -- generate then 503s with a clear message instead of calling out anywhere.
ANTHROPIC_API_KEY=
CLOUD_LLM_MODEL=claude-sonnet-5
