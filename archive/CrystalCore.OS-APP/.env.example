# Copy this file to .env and fill in your real key(s).
# You only need a key for the AIs you want to talk to — any one is enough.

# Default AI when the app opens: grok, deepseek, chatgpt, gemini,
# mistral, llama, perplexity, or claude (switchable in the chat UI)
AI_PROVIDER=grok

# --- Grok (xAI) --- get a key at https://console.x.ai
XAI_API_KEY=your_grok_key_here
# XAI_MODEL=grok-3

# --- DeepSeek --- get a key at https://platform.deepseek.com
# DEEPSEEK_API_KEY=your_deepseek_key_here
# DEEPSEEK_MODEL=deepseek-chat

# --- ChatGPT (OpenAI) --- get a key at https://platform.openai.com
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-5

# --- Gemini (Google) --- get a key at https://aistudio.google.com
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-2.5-flash

# --- Mistral --- get a key at https://console.mistral.ai
# MISTRAL_API_KEY=your_mistral_key_here
# MISTRAL_MODEL=mistral-large-latest

# --- Llama (served by Groq) --- get a key at https://console.groq.com
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Perplexity --- get a key at https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=your_perplexity_key_here
# PERPLEXITY_MODEL=sonar

# --- Claude (Anthropic) --- get a key at https://platform.claude.com
# ANTHROPIC_API_KEY=your_claude_key_here
# ANTHROPIC_MODEL=claude-opus-4-8
